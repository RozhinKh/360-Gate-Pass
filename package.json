{
  "name": "360gatepass",
  "version": "1.0.0",
  "description": "360GatePass is a web-based system for entry requests, approvals, and guest tracking",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest --detectOpenHandles",
    "test:unit": "jest --testPathPattern=tests/unit --detectOpenHandles",
    "test:integration": "jest --testPathPattern=tests/integration --detectOpenHandles",
    "test:frontend": "jest --testPathPattern=tests/frontend --detectOpenHandles",
    "test:coverage": "jest --coverage --detectOpenHandles",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "guest",
    "access",
    "control",
    "pass",
    "security"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.1.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "supertest": "^6.3.3",
    "nodemon": "^3.0.2"
  }
}
